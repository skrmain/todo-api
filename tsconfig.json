{
    "compilerOptions": {
        "target": "esnext",
        "moduleResolution": "nodenext",
        "module": "nodenext",
        "types": ["node"],

        "sourceMap": true,

        "declaration": true,
        "declarationMap": true,
        "incremental": true,

        "outDir": "./dist",
        "rootDir": "./src",
        "tsBuildInfoFile": "./dist/.tsbuildinfo"
    },
    "include": ["src/**/*"]
}
