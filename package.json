{
    "name": "todo-api",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "node --env-file-if-exists=.env dist/cluster.js",
        "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.3.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "express": "^5.3.0",
        "zod": "^4.6.7"
    }
}
